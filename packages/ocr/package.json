{
  "name": "@snapshort/ocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external tesseract.js",
    "dev": "tsup src/index.ts --format esm --dts --watch --external tesseract.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@snapshort/core": "workspace:*",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
